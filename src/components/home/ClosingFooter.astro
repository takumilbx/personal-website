---
import type { Link } from '../../lib/content';
interface Props { text: string; social: Link[] }
const { text, social } = Astro.props;
---
<footer class="border-t border-cream/10 bg-ink px-6 py-10 text-[12px] text-cream/55 sm:px-10 sm:text-[13px]">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <p>{text}</p>
    <ul class="flex flex-wrap gap-5">
      {social.map((s) => (
        <li><a href={s.href} target="_blank" rel="noopener" class="transition-opacity duration-300 ease-premium hover:opacity-50">{s.label}</a></li>
      ))}
    </ul>
  </div>
</footer>
