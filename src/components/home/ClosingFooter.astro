---
import type { Link } from '../../lib/content';
interface Props { text: string; social: Link[] }
const { text, social } = Astro.props;
---
<footer class="bg-ink px-6 py-10 text-xs text-cream/60 sm:px-10 sm:text-sm">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <p>{text}</p>
    <ul class="flex flex-wrap gap-5">
      {social.map((s) => (
        <li><a href={s.href} target="_blank" rel="noopener" class="transition-opacity duration-300 hover:opacity-60">{s.label}</a></li>
      ))}
    </ul>
  </div>
</footer>
