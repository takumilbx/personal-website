---
// Temporary comparison page for choosing the site's typeface. Delete once the decision is made.
import '../../styles/global.css';
import { withBase } from '../../lib/url';

const candidates = [
  { id: 'kanit', name: 'Kanit (current)', note: 'Thai and Latin in one family. Geometric, wide, rounded terminals.', stack: "'Kanit', sans-serif" },
  { id: 'prompt', name: 'Prompt', note: 'Thai and Latin in one family, from the same Bangkok foundry as Kanit. Softer and more even.', stack: "'Prompt', sans-serif" },
  { id: 'anuphan', name: 'Anuphan', note: 'Thai and Latin in one family. Contemporary, plainer than Kanit, no italics.', stack: "'Anuphan', sans-serif" },
  { id: 'sarabun', name: 'Sarabun', note: 'Thai and Latin in one family. Humanist and quiet; the Thai government document face.', stack: "'Sarabun', sans-serif" },
  { id: 'plex', name: 'IBM Plex Sans + IBM Plex Sans Thai', note: 'Two matched families with one weight scale. Neutral, slightly technical.', stack: "'IBM Plex Sans', 'IBM Plex Sans Thai', sans-serif" },
  { id: 'archivo', name: 'Archivo + Noto Sans Thai', note: 'Closest licensed match to the Helvetica look of the reference hero. Thai from Noto.', stack: "'Archivo', 'Noto Sans Thai', sans-serif" },
  { id: 'hanken', name: 'Hanken Grotesk + Noto Sans Thai', note: 'Lighter grotesk, also Helvetica-like, with a wider range of weights. Thai from Noto.', stack: "'Hanken Grotesk', 'Noto Sans Thai', sans-serif" },
  { id: 'instrument', name: 'Instrument Sans + Noto Sans Thai', note: 'Grotesk with a little more character in the Latin. Thai from Noto.', stack: "'Instrument Sans', 'Noto Sans Thai', sans-serif" },
];

const fontsHref =
  'https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;700;900' +
  '&family=Prompt:wght@300;400;500;700;900' +
  '&family=Anuphan:wght@300;400;500;700' +
  '&family=Sarabun:wght@300;400;500;700' +
  '&family=IBM+Plex+Sans:wght@300;400;500;700&family=IBM+Plex+Sans+Thai:wght@300;400;500;700' +
  '&family=Archivo:wght@300;400;500;700;900' +
  '&family=Hanken+Grotesk:wght@300;400;500;700;900' +
  '&family=Instrument+Sans:wght@400;500;700' +
  '&family=Noto+Sans+Thai:wght@300;400;500;700' +
  '&display=swap';

const paragraph = "I work between Thailand and Japan on one question: why a device in every student's hands so rarely becomes a better lesson.";
const thai = 'ทำไมแจกแท็บเล็ตให้เด็กทุกคนแล้วห้องเรียนถึงยังไม่เปลี่ยน';
---
<!doctype html>
<html lang="en" class="bg-ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Font comparison · Takumi</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />
  </head>
  <body class="bg-ink text-cream antialiased" style="font-family: system-ui, sans-serif;">
    <main class="mx-auto max-w-5xl px-6 py-12 sm:px-10">
      <p class="text-xs uppercase tracking-[0.2em] text-cream/50">Temporary page</p>
      <h1 class="mt-2 text-2xl font-medium">Which typeface reads right?</h1>
      <p class="mt-3 max-w-2xl text-sm text-cream/70">Each block sets the same five things in one candidate: the hero name at marquee weight, a section heading in black uppercase, body text, the small navigation line, and a Thai sentence. All are on Google Fonts and cover Thai. Reply with the number, and say whether the size or weight also felt off.</p>
      <p class="mt-2 text-sm"><a href={withBase('/en/')} class="underline underline-offset-4 hover:opacity-60">Back to the home page</a></p>

      {candidates.map((c, i) => (
        <section class="mt-14 border-t border-cream/15 pt-8" style={`font-family: ${c.stack}`}>
          <p class="text-xs uppercase tracking-[0.2em] text-cream/50" style="font-family: system-ui, sans-serif">{i + 1}. {c.name}</p>
          <p class="mt-1 text-sm text-cream/60" style="font-family: system-ui, sans-serif">{c.note}</p>
          <p class="mt-6 whitespace-nowrap overflow-hidden font-medium leading-none" style="font-size: clamp(3rem, 12vw, 9rem)">Takumi — Oshiyama</p>
          <p class="hero-heading mt-6 font-black uppercase leading-none tracking-tight" style="font-size: clamp(2.5rem, 8vw, 6rem)">About me</p>
          <p class="mt-6 max-w-[560px] font-medium leading-relaxed" style="font-size: clamp(1rem, 2vw, 1.35rem)">{paragraph}</p>
          <p class="mt-4 max-w-[560px] font-light leading-relaxed opacity-70" style="font-size: 1.05rem">{paragraph}</p>
          <p class="mt-4 text-sm">Work &nbsp;·&nbsp; Creator &nbsp;·&nbsp; About &nbsp;·&nbsp; 2026 &nbsp;·&nbsp; <span class="uppercase tracking-widest">Read the case study</span></p>
          <p class="mt-4 max-w-[560px] leading-relaxed" lang="th" style="font-size: 1.2rem">{thai}</p>
        </section>
      ))}
    </main>
  </body>
</html>
