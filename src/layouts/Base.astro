---
import '../styles/global.css';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  image?: string;
}
const { title, description = '', lang = 'en', image = '/images/social.jpg' } = Astro.props;
// The GitHub Pages address is a preview with placeholder assets; keep it out of search results.
const preview = (import.meta.env.SITE ?? '').includes('github.io');
const siteUrl = import.meta.env.SITE ?? 'https://takumilbx.github.io';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const socialImageUrl = new URL(withBase(image), siteUrl).href;
---
<!doctype html>
<html lang={lang} class="bg-ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {preview && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0C0C0C" />

    <!-- Favicon & Touch Icons -->
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="512x512" href={withBase('/images/icon.png')} />
    <link rel="apple-touch-icon" href={withBase('/images/icon.png')} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={socialImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={socialImageUrl} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600&family=Noto+Sans+Thai:wght@300;400;500;600&display=swap" />
    {/* Japanese is only a few characters for now, so load just those glyphs. Widen when the Japanese pages arrive. */}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500&text=%E4%BB%95%E4%BA%8B&display=swap" />
  </head>
  <body class="bg-ink text-cream font-sans antialiased">
    <div id="root" class="bg-ink" style="overflow-x: clip;">
      <slot />
    </div>
    <div class="grain" aria-hidden="true"></div>
  </body>
</html>
