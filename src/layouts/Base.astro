---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}
const { title, description = '', lang = 'en' } = Astro.props;
---
<!doctype html>
<html lang={lang} class="bg-ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0C0C0C" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;700;900&display=swap" />
  </head>
  <body class="bg-ink text-cream font-sans antialiased">
    <div id="root" class="bg-ink" style="overflow-x: clip;">
      <slot />
    </div>
  </body>
</html>
